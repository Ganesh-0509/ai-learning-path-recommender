# Copy to .env and adjust if needed. No secrets: this project uses only a
# locally-hosted database file and a locally-hosted open-source LLM/embedding
# model — see docs/SECURITY.md.

DATABASE_URL="file:./dev.db"

# Local LLM, served by Ollama (https://ollama.com) — run `ollama serve` and
# `ollama pull llama3.2:3b` before starting the app in development.
LLM_HOST="http://localhost:11434"
LLM_MODEL="llama3.2:3b"

# Local embedding model, run in-process via @huggingface/transformers — no
# network call, downloaded once to a local cache on first run.
EMBEDDING_MODEL="Xenova/all-MiniLM-L6-v2"
